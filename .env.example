# ==========================================
# Fridge Fusion - Environment Configuration
# ==========================================
# Copy this file to backend/.env and populate with real secrets.
# NEVER commit the actual .env file to version control.

# --- SERVER SETTINGS ---
PORT=5000

# --- DATABASE (MongoDB) ---
# Use localhost for local dev, or MongoDB Atlas URI for production
MONGODB_URI=mongodb://localhost:27017/fridge-fusion

# --- AUTHENTICATION ---
# Generate a secure 256-bit random string for production
JWT_SECRET=your_jwt_secret_key_here_for_development_only

# --- AI INTEGRATION (Groq Llama-3.3) ---
# Get your API key at https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here
